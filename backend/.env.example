# Copy to .env and fill in real values
DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=https://munister-v.github.io
SITE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Google Sign-In - OAuth 2.0 Web client ID from Google Cloud Console.
# Leave empty to disable the "Continue with Google" button.
GOOGLE_CLIENT_ID=
# Secret guarding /api/auth/make-admin and /set-role. Leave unset to disable them.
ADMIN_SECRET=

# ── Image search (vocabulary cards, games) ──────────────────────────────────
# Chain: Unsplash → Pexels → Pixabay → Wikimedia. The first three are free to
# print without obligations (Unsplash and Pexels appreciate a credit, Pixabay
# needs none). Wikimedia is last on purpose: it is CC-licensed, where crediting
# the author is usually REQUIRED - fine as a last resort, wrong as a default.
# With no keys at all the chain silently reaches Wikimedia and returns loosely
# related pictures, which reads as "image search is broken". Check which
# sources are actually live with GET /api/images/status.
#
# Unsplash - 50 req/hr on demo, 5000/hr after approval: unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=
# Pexels - instant key, 200 req/hr: pexels.com/api/new
PEXELS_API_KEY=
# Pixabay - instant key, no approval: pixabay.com/api/docs/
PIXABAY_API_KEY=

# ── AI engine (Teacher Tools) ───────────────────────────────────────────────
# Free OpenAI-compatible LLM for /api/ai/teacher-tool. Leave AI_API_KEY empty to
# keep the offline rule-engine fallback. Get a free key from Groq or Gemini.
#   Groq    : AI_BASE_URL=https://api.groq.com/openai/v1                          AI_MODEL=llama-3.3-70b-versatile
#   Gemini  : AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai AI_MODEL=gemini-2.0-flash
#   OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1                          AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
# AI_TIMEOUT_MS=25000
# Backup provider - the third step of the chain: primary model -> light model
# on the same key -> THIS -> local rule templates. Tried only when the primary
# provider is unreachable or rate-limited.
#
# Anything built here is labelled: the API returns engine:"backup", the board
# writes "backup engine" on the lesson frame and does not cache the result, so
# a weaker fallback can never be mistaken for how the tool normally writes.
# Leave the key empty to disable the step entirely (chain behaves as if absent).
#
# AI_BACKUP_* is the current spelling; AI_*_2 is still read for compatibility.
AI_BACKUP_KEY=
AI_BACKUP_URL=https://openrouter.ai/api/v1
AI_BACKUP_MODEL=openai/gpt-oss-20b:free
# Native OpenRouter fallback chain. When AI_BASE_URL or AI_BASE_URL_2 points to
# OpenRouter, the backend sends this list as `models` so OpenRouter can fail over
# across models/providers before the app falls back to local templates.
AI_OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,google/gemini-2.0-flash-exp:free,qwen/qwen-2.5-72b-instruct:free,deepseek/deepseek-chat:free
# Prefer speed across available OpenRouter endpoints/models. Valid: throughput,
# latency, price. Default is throughput.
# AI_OPENROUTER_SORT=throughput
# Enable OpenRouter response-healing plugin for JSON repair. Set 0 to disable.
# AI_OPENROUTER_RESPONSE_HEALING=1
# Attempts per provider before moving to the next local provider.
# AI_MAX_ATTEMPTS=2
